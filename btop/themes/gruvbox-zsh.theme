# Gruvbox ZSH-style Theme (semantic colors)

theme[main_bg]="#1d2021"
theme[main_fg]="#ebdbb2"

# Titles (like your yellow dir)
theme[title]="#fabd2f"
theme[hi_fg]="#fbf1c7"

# Selection
theme[selected_bg]="#3c3836"
theme[selected_fg]="#ebdbb2"

# Inactive / timestamp gray
theme[inactive_fg]="#928374"

# Text + meters
theme[graph_text]="#a89984"
theme[meter_bg]="#282828"

# Boxes (neutral like your prompt)
theme[cpu_box]="#83a598"
theme[mem_box]="#b8bb26"
theme[net_box]="#8ec07c"
theme[proc_box]="#d3869b"

# CPU (green → yellow → red like success → warning → error)
theme[cpu_start]="#b8bb26"
theme[cpu_mid]="#fabd2f"
theme[cpu_end]="#fb4934"

# Temperature (same logic)
theme[temp_start]="#b8bb26"
theme[temp_mid]="#fabd2f"
theme[temp_end]="#fb4934"

# Memory
theme[free_start]="#8ec07c"
theme[free_mid]="#b8bb26"
theme[free_end]="#fabd2f"

theme[used_start]="#fb4934"
theme[used_mid]="#fabd2f"
theme[used_end]="#b8bb26"

# Cache
theme[cached_start]="#83a598"
theme[cached_mid]="#8ec07c"
theme[cached_end]="#b8bb26"

# Network (aqua style)
theme[download_start]="#83a598"
theme[download_mid]="#8ec07c"
theme[download_end]="#b8bb26"

theme[upload_start]="#d3869b"
theme[upload_mid]="#fabd2f"
theme[upload_end]="#fb4934"
