(defwindow cpu
  :monitor 0
  :geometry (geometry :x 50 :y 50 :width 120 :height 40)
  (cpu))

(defwindow ram
  :monitor 0
  :geometry (geometry :x 200 :y 50 :width 150 :height 40)
