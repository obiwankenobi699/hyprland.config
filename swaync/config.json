{
    "$schema": "/etc/xdg/swaync/configschema.json",
    "positionX": "center",
    "positionY": "top",
    "cssPriority": "user",
    "control-center-width": 380,
    "fit-to-screen": false,
    "control-center-height": 600,
    "notification-window-width": 360,
    "notification-icon-size": 40,
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,
    "notification-inline-replies": true,
    "notification-2fa-action": false,
    "timeout": 5,
    "timeout-low": 2,
    "timeout-critical": 6,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": false,
    "widgets": [
        "mpris",
        "dnd",
        "notifications",
        "buttons-grid"
    ],
    "widget-config": {
        "dnd": {
            "text": "Do not disturb"
        },
        "mpris": {
            "image-size": 80,
            "image-radius": 10,
            "autohide": true,
            "blacklist": ["org.mpris.MediaPlayer2.playerctld"]
        },
        "buttons-grid": {
            "actions": [
                {
                    "label": "",
                    "command": "hyprctl dispatch exec kitty -- -e btop ; swaync-client -cp"
                },
                {
                    "label": "󰍹",
                    "command": "hyprctl dispatch exec qalculate-gtk ; swaync-client -cp"
                },
                {
                    "label": "󰖩",
                    "command": "hyprctl dispatch exec kitty -- -e nmtui ; swaync-client -cp"
                },
                {
                    "label": "󰂯",
                    "command": "hyprctl dispatch exec blueman-manager ; swaync-client -cp"
                },
                {
                    "label": "󰕾",
                    "command": "hyprctl dispatch exec pavucontrol ; swaync-client -cp"
                },
                {
                    "label": "",
                    "command": "swaync-client -cp ; hyprctl dispatch exec wlogout"
                }
            ]
        }
    }
}